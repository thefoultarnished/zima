import "../fonts/Inter-Regular.ttf";
import "../fonts/Inter-Bold.ttf";
import "../fonts/Inter-Italic.ttf";
import "../fonts/Newsreader-Regular.ttf";
import "../fonts/Newsreader-Bold.ttf";
import "../fonts/Newsreader-Italic.ttf";
import "../fonts/Literata-Regular.ttf";
import "../fonts/Literata-Bold.ttf";
import "../fonts/Literata-Italic.ttf";
import "../fonts/JetBrainsMono-Regular.ttf";
import "../fonts/JetBrainsMono-Bold.ttf";
import "../fonts/JetBrainsMono-Italic.ttf";

import { Theme } from "theme.slint";
import { ColourDot, ColourPicker, FormatButton, Icon, IconButton, Icons, ResizeEdge, TrafficLight } from "widgets.slint";
import { NoteRow, Sidebar, TagRow } from "sidebar.slint";
import { Editor, LinkRow, Suggestion } from "editor.slint";
import { LinkPreview, LinkPreviewCard, MdBlock } from "markdown.slint";
import { ReminderPopover, ReminderRow, Toast } from "reminders.slint";
import { SettingsPopover, SettingsWindow } from "settings.slint";
import { Presentation } from "present.slint";
import { ShortcutRow } from "shortcuts.slint";
import { PaletteItem, QuickSwitcher } from "palette.slint";
import { CalendarDay, CalendarPopover } from "calendar.slint";
import { StatCell, StatSummary, StatsPopover } from "stats.slint";
import { StickyWindow } from "sticky.slint";
import { CaptureWindow } from "capture.slint";
