import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icon, Icons } from "widgets.slint";

component FindButton {
    in property <string> icon;
    in property <bool> active;
    callback clicked();

    width: 26px;
    height: 28px;

    Rectangle {
        border-radius: 6px;
        background: touch.pressed || root.active ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
    }

    Icon {
        width: 12px;
        height: 12px;
        commands: root.icon;
        stroke: touch.has-hover || root.active ? Theme.ink : Theme.muted;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component TextButton {
    in property <string> label;
    callback clicked();

    width: text.preferred-width + 18px;
    height: 28px;

    Rectangle {
        border-radius: 6px;
        background: touch.pressed ? Theme.selected : touch.has-hover ? Theme.hover : Theme.hover.with-alpha(0.5);
    }

    text := Text {
        text: root.label;
        color: Theme.ink-soft;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}
import { BacklinkList, BlockView, LinkRow, MdBlock } from "markdown.slint";
import { NoteRow } from "sidebar.slint";
import { LiveEditor } from "live.slint";

export struct Suggestion {
    name: string,
    hint: string,
}

// The @ and / command menu. The caller gives the caret's line (top edge) and where the menu must
// stay inside. It opens one line below the caret, or above it when there's no room.
component SuggestionPopup inherits Rectangle {
    in property <[Suggestion]> suggestions;
    in property <int> index;
    in property <length> caret-x;
    in property <length> caret-y;
    in property <length> line-height;
    in property <length> limit-x;
    in property <length> limit-y;

    property <length> below: root.caret-y + root.line-height;
    x: min(root.caret-x, root.limit-x - self.width - 12px);
    y: root.below + self.height > root.limit-y - 8px ? root.caret-y - self.height - 6px : root.below;
    width: 280px;
    height: list.preferred-height;
    border-radius: 10px;
    background: Theme.popover;
    border-width: 1px;
    border-color: Theme.rule;
    drop-shadow-blur: 18px;
    drop-shadow-offset-y: 6px;
    drop-shadow-color: #00000035;

    list := VerticalLayout {
        padding: 5px;
        spacing: 2px;

        for suggestion[i] in root.suggestions: Rectangle {
            height: 34px;
            border-radius: 7px;
            background: i == root.index ? Theme.selected : transparent;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 10px;

                Text {
                    text: suggestion.name;
                    color: Theme.accent;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                }

                Text {
                    horizontal-stretch: 1;
                    text: suggestion.hint;
                    color: Theme.muted;
                    font-size: 12px;
                    overflow: elide;
                    vertical-alignment: center;
                }

                if i == root.index: Text {
                    text: "Tab";
                    color: Theme.muted;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// The writing column: title + body text, optionally with a live Markdown preview.
export component Editor {
    in property <bool> has-note;
    in property <string> current-id;
    in-out property <string> note-title;
    in-out property <string> note-body;
    in property <int> note-words;
    // Word goal for this note; 0 = none.
    in property <int> note-goal;
    // Keep the cursor line centred (only in zen mode).
    in property <bool> typewriter;
    // Fade the text above and below the cursor line (zen mode).
    in property <bool> spotlight;
    // Find bar.
    in-out property <bool> find-open;
    in-out property <bool> find-replace;
    in property <string> find-status;
    // 0 = edit, 1 = split, 2 = preview, 3 = live.
    in property <int> view-mode;
    in property <bool> wide;
    in property <bool> show-status: true;
    // Share of the width the text gets in Split view (dragged by the divider).
    in-out property <float> split-ratio: 0.5;
    callback split-resized(float);
    // The note's file couldn't be read: no editing, and a message instead of the text.
    in property <bool> unreadable;
    in property <[MdBlock]> blocks;
    // Live mode: the rendered blocks before and after the raw part, and the raw part itself.
    in property <[MdBlock]> live-before;
    in property <[MdBlock]> live-after;
    in-out property <string> live-text;
    in property <int> live-rev;
    in property <int> live-len;
    in property <int> live-start;
    in property <[Suggestion]> suggestions;
    in-out property <int> suggestion-index;

    // Selection in the body, for formatting commands. In Live mode the raw part's offsets are
    // shifted to the whole note, so the commands see the same offsets as in the other modes.
    out property <int> sel-anchor: root.view-mode == 3 ? root.live-start + live.sel-anchor : body.anchor-position-byte-offset;
    out property <int> sel-cursor: root.view-mode == 3 ? root.live-start + live.sel-cursor : body.cursor-position-byte-offset;
    out property <bool> body-focused: body.has-focus || live.input-focused;

    callback title-edited(string);
    // The text and the cursor's byte offset.
    callback body-edited(string, int);
    callback cursor-moved(int);
    callback new-note();
    callback toggle-task(int);
    callback link-clicked(string);
    // The pointer rests on a block with [[links]] (their titles, window position), or leaves it.
    callback link-hover([string], length, length);
    callback link-hover-end();
    callback live-edited(string, int, int);
    callback live-cursor-moved(int);
    callback live-activate(int);
    callback live-end();
    // Ctrl+click on a rendered block in Live mode: open its first link.
    callback live-follow(int);
    // Return true if Rust handled the key (the text box then ignores it).
    callback live-key(string) -> bool;
    callback open-note(string);
    // The empty screen's "Today's note" button.
    callback open-daily();
    // Notes to jump back into, shown when no note is open.
    in property <[NoteRow]> recent-notes;
    // Notes linking here with [[…]], shown under the preview.
    in property <[LinkRow]> backlinks;
    callback find-edited(string);
    callback find-step(int);
    callback replace-one(string);
    callback replace-all(string);
    callback find-closed();

    public function focus-find() {
        find-input.focus();
        find-input.select-all();
    }


    // Before the raw part moves to other blocks: remember the caret's height on screen.
    public function live-anchor() {
        live.live-anchor();
    }

    // Select text without taking focus (find highlights a match while you keep typing in the find box).
    public function select-in-body(anchor: int, cursor: int) {
        if (root.view-mode == 3) {
            live.set-live-selection(anchor - root.live-start, cursor - root.live-start, false);
        } else {
            body.set-selection-offsets(anchor, cursor);
        }
    }

    public function focus-title() {
        if (root.view-mode == 3) {
            live.focus-title();
        } else {
            title.focus();
        }
    }

    public function focus-body() {
        if (root.view-mode == 3) {
            live.focus-live();
        } else {
            body.focus();
        }
    }

    public function set-body-selection(anchor: int, cursor: int) {
        if (root.view-mode == 3) {
            live.set-live-selection(anchor - root.live-start, cursor - root.live-start, true);
        } else {
            body.focus();
            body.set-selection-offsets(anchor, cursor);
        }
    }

    // The hover card would be left pointing at something that moved or went away.
    changed blocks => { root.link-hover-end(); }
    changed view-mode => { root.link-hover-end(); }

    // Start each note scrolled to the top.
    changed current-id => {
        scroll.content-y = 0;
        preview.content-y = 0;
        live.scroll-to-top();
    }

    property <length> edit-width: root.view-mode == 2 ? 0px : root.view-mode == 1 ? root.width * root.split-ratio : root.width;
    property <length> font-size: 16px * Theme.text-scale;
    // Room under the text for the word count, so it never sits on top of the last lines.
    property <length> status-height: root.has-note && root.show-status ? 34px : 0px;

    // Edit pane
    scroll := ScrollView {
        x: 0;
        width: root.edit-width;
        height: root.height - root.status-height;
        visible: root.has-note && (root.view-mode == 0 || root.view-mode == 1);

        // Split view: the text fills its pane, so it follows the divider. Otherwise a readable
        // 680 px column, unless Wide is on.
        property <length> column-width: root.view-mode == 1 ? max(200px, self.visible-width - 64px) : root.wide ? max(200px, self.visible-width - 160px) : min(680px, self.visible-width - 64px);
        property <length> column-x: (self.visible-width - self.column-width) / 2;
        property <length> pad-top: 36px;
        property <length> pad-bottom: root.typewriter ? self.visible-height * 0.55 : 120px;
        property <length> body-y: title-box.y + title-box.height + 14px;
        property <Point> cursor;

        content-width: self.visible-width;
        content-height: max(self.visible-height, self.body-y + body.preferred-height + self.pad-bottom);

        // The title wraps onto more lines when the pane is narrow. It's still one line of text:
        // Enter is caught here before the title sees it and moves on to the body instead.
        title-box := FocusScope {
            x: scroll.column-x;
            y: scroll.pad-top;
            width: scroll.column-width;
            height: title.height;
            capture-key-pressed(event) => {
                if (title.has-focus && event.text == Key.Return) {
                    body.focus();
                    return accept;
                }
                return reject;
            }

            title := TextInput {
                x: 0;
                y: 0;
                width: parent.width;
                height: max(40px * Theme.text-scale, self.preferred-height);
                text <=> root.note-title;
                single-line: false;
                wrap: word-wrap;
                font-family: Theme.heading-font;
                font-size: 28px * Theme.text-scale;
                font-weight: 700;
                color: Theme.heading;
                selection-background-color: Theme.selection;
                selection-foreground-color: Theme.ink;
                edited => {
                    root.title-edited(self.text);
                }
            }
        }

        Text {
            x: title-box.x;
            y: title-box.y;
            visible: root.note-title.is-empty;
            text: "Untitled";
            color: Theme.muted.with-alpha(0.6);
            font-family: Theme.heading-font;
            font-size: 28px * Theme.text-scale;
            font-weight: 700;
        }

        body := TextInput {
            x: scroll.column-x;
            y: scroll.body-y;
            width: scroll.column-width;
            // Fill the visible area so clicking anywhere below the text focuses it.
            height: max(self.preferred-height, scroll.visible-height - scroll.body-y);
            text <=> root.note-body;
            read-only: root.unreadable;
            line-height-factor: Theme.line-spacing;
            single-line: false;
            wrap: word-wrap;
            font-family: Theme.font-face;
            font-size: root.font-size;
            color: Theme.ink;
            selection-background-color: Theme.selection;
            selection-foreground-color: Theme.ink;
            edited => {
                root.body-edited(self.text, self.cursor-position-byte-offset);
            }

            // Keep the cursor in view while typing, and tell Rust where it is (for @ suggestions).
            cursor-position-changed(cpos) => {
                scroll.cursor = cpos;
                root.cursor-moved(self.cursor-position-byte-offset);
                if (root.typewriter) {
                    // Typewriter scrolling: the cursor line stays a little above the middle.
                    scroll.content-y = min(0px, scroll.visible-height * 0.45 - self.y - cpos.y);
                } else if (self.y + cpos.y + scroll.content-y < 16px) {
                    scroll.content-y = min(0px, 16px - self.y - cpos.y);
                } else if (self.y + cpos.y + 48px + scroll.content-y > scroll.visible-height) {
                    scroll.content-y = scroll.visible-height - self.y - cpos.y - 48px;
                }
            }
        }

        Text {
            x: body.x;
            y: body.y;
            width: body.width;
            visible: root.note-body.is-empty;
            text: root.unreadable
                ? "Couldn\u{2019}t read this note\u{2019}s file. Your text is still in it, and Zima won\u{2019}t save over it. Close any app that has it open, or let OneDrive or Google Drive finish downloading it, then open the note again."
                : "Start writing…  or try \u{201c}@remind me to stretch in 20 min\u{201d}";
            wrap: word-wrap;
            color: root.unreadable ? Theme.danger : Theme.muted;
            font-family: Theme.font-face;
            font-size: root.font-size;
        }

        // @ command suggestions, just below the cursor (or above it near the bottom of the view).
        if root.suggestions.length > 0 && root.view-mode != 3: SuggestionPopup {
            suggestions: root.suggestions;
            index: root.suggestion-index;
            caret-x: body.x + scroll.cursor.x;
            caret-y: body.y + scroll.cursor.y;
            line-height: root.font-size * 1.5;
            limit-x: scroll.visible-width;
            limit-y: scroll.visible-height - scroll.content-y;
        }
    }

    // Split divider: drag to resize (25% to 75%, as in Rust), double-click to share the width equally.
    // Above the preview, which would otherwise catch the pointer on its half.
    if root.has-note && root.view-mode == 1: Rectangle {
        x: root.edit-width - 4px;
        width: 9px;
        z: 1;

        Rectangle {
            x: 4px;
            width: 1px;
            background: split-touch.has-hover || split-touch.pressed ? Theme.accent : Theme.rule;
        }

        split-touch := TouchArea {
            mouse-cursor: ew-resize;
            moved => {
                if (self.pressed) {
                    root.split-ratio = max(0.25, min(0.75, (root.edit-width + self.mouse-x - self.pressed-x) / root.width));
                }
            }
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                    root.split-resized(root.split-ratio);
                }
            }
            double-clicked => {
                root.split-ratio = 0.5;
                root.split-resized(root.split-ratio);
            }
        }
    }

    // Live mode (view mode 3): every block drawn like the preview, the block being edited as raw Markdown.
    live := LiveEditor {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height - root.status-height;
        visible: root.has-note && root.view-mode == 3;
        before: root.live-before;
        after: root.live-after;
        live-text <=> root.live-text;
        live-rev: root.live-rev;
        live-len: root.live-len;
        live-start: root.live-start;
        unreadable: root.unreadable;
        typewriter: root.typewriter;
        wide: root.wide;
        note-title <=> root.note-title;
        title-edited(text) => { root.title-edited(text); }
        live-edited(text, cursor, rev) => { root.live-edited(text, cursor, rev); }
        live-cursor-moved(cursor) => { root.live-cursor-moved(cursor); }
        live-activate(line) => { root.live-activate(line); }
        live-end => { root.live-end(); }
        live-follow(line) => { root.live-follow(line); }
        live-key(key) => { return root.live-key(key); }
        backlinks: root.backlinks;
        open-note(id) => { root.open-note(id); }
        toggle-task(line) => { root.toggle-task(line); }
        link-clicked(url) => { root.link-clicked(url); }
        link-hover(titles, x, y) => { root.link-hover(titles, x, y); }
        link-hover-end => { root.link-hover-end(); }
    }

    // Spotlight and the Live @ menu draw over the Live editor, so they come after it.
    // Spotlight: fades towards the top and bottom of the edit pane, leaving the writing line clear.
    // The top fade starts under the title, so the title stays readable while it's on screen.
    if root.has-note && root.spotlight && (root.view-mode == 0 || root.view-mode == 1 || root.view-mode == 3): Rectangle {
        x: 0;
        y: max(0px, root.view-mode == 3 ? live.content-y + live.title-bottom : scroll.content-y + title-box.y + title-box.height);
        width: root.edit-width;
        height: root.height * 0.32;
        background: @linear-gradient(180deg, Theme.paper 15%, Theme.paper.with-alpha(0) 100%);
    }
    if root.has-note && root.spotlight && (root.view-mode == 0 || root.view-mode == 1 || root.view-mode == 3): Rectangle {
        x: 0;
        y: root.height * 0.6;
        width: root.edit-width;
        height: root.height * 0.4;
        background: @linear-gradient(0deg, Theme.paper 15%, Theme.paper.with-alpha(0) 100%);
    }

    if root.suggestions.length > 0 && root.view-mode == 3: SuggestionPopup {
        suggestions: root.suggestions;
        index: root.suggestion-index;
        caret-x: live.live-caret.x;
        caret-y: live.live-caret.y;
        line-height: root.font-size * 1.5;
        limit-x: root.width;
        limit-y: root.height - root.status-height;
    }

    // Preview pane
    preview := ScrollView {
        x: root.edit-width;
        width: root.width - root.edit-width;
        height: root.height - root.status-height;
        visible: root.has-note && (root.view-mode == 1 || root.view-mode == 2);
        scrolled => { root.link-hover-end(); }

        // Split view: the text fills its pane, so it follows the divider. Otherwise a readable
        // 680 px column, unless Wide is on.
        property <length> column-width: root.view-mode == 1 ? max(200px, self.visible-width - 64px) : root.wide ? max(200px, self.visible-width - 160px) : min(680px, self.visible-width - 64px);

        VerticalLayout {
            width: preview.visible-width;
            padding-top: 36px;
            padding-bottom: 120px;
            padding-left: (preview.visible-width - preview.column-width) / 2;
            padding-right: (preview.visible-width - preview.column-width) / 2;
            spacing: 0px;
            alignment: start;

            Text {
                text: root.note-title.is-empty ? "Untitled" : root.note-title;
                color: root.note-title.is-empty ? Theme.muted.with-alpha(0.6) : Theme.heading;
                font-family: Theme.heading-font;
                font-size: 28px * Theme.text-scale;
                font-weight: 700;
                wrap: word-wrap;
            }

            Rectangle {
                height: 18px;
            }

            if root.blocks.length == 0: Text {
                text: "Nothing to preview yet.";
                color: Theme.muted;
                font-size: 15px;
            }

            for block in root.blocks: BlockView {
                block: block;
                link-previews: true;
                toggle-task(line) => { root.toggle-task(line); }
                link-clicked(url) => { root.link-clicked(url); }
                link-hover(titles, x, y) => { root.link-hover(titles, x, y); }
                link-hover-end => { root.link-hover-end(); }
            }

            if root.backlinks.length > 0: BacklinkList {
                links: root.backlinks;
                open-note(id) => { root.open-note(id); }
            }
        }
    }

    // Words (with goal progress), reading time and characters, bottom right of the edit pane.
    if root.has-note && root.show-status: pill := Rectangle {
        property <float> progress: root.note-goal > 0 ? Math.min(1, root.note-words / root.note-goal) : 0;
        x: (root.view-mode == 2 ? root.width : root.edit-width) - self.width - 14px;
        y: root.height - self.height - 10px;
        width: status.preferred-width + 16px;
        height: root.note-goal > 0 ? 28px : 22px;
        border-radius: 6px;
        background: Theme.paper.with-alpha(0.85);

        status := Text {
            y: 0;
            height: 22px;
            text: (root.note-goal > 0 ? root.note-words + " / " + root.note-goal + " words" : root.note-words + (root.note-words == 1 ? " word" : " words"))
                + "  ·  " + Math.max(1, Math.round(root.note-words / 230)) + " min read"
                + "  ·  " + root.note-body.character-count + " characters";
            color: Theme.muted;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        // Goal progress bar.
        if root.note-goal > 0: Rectangle {
            x: 8px;
            y: 21px;
            width: parent.width - 16px;
            height: 3px;
            border-radius: 1.5px;
            background: Theme.selected;

            Rectangle {
                x: 0;
                width: parent.width * pill.progress;
                height: 100%;
                border-radius: 1.5px;
                background: pill.progress >= 1 ? #3fb950 : Theme.accent;
                animate width { duration: 300ms; }
            }
        }
    }

    // Find & replace (Ctrl+F / Ctrl+H), top right of the edit pane.
    // Always built; hidden and click-through while closed.
    Rectangle {
        visible: root.find-open && root.has-note && root.view-mode != 2;
        x: root.edit-width - self.width - 18px;
        y: 10px;
        width: 340px;
        height: find-layout.preferred-height;
        border-radius: 10px;
        background: Theme.popover;
        border-width: 1px;
        border-color: Theme.rule;
        drop-shadow-blur: 18px;
        drop-shadow-offset-y: 6px;
        drop-shadow-color: #00000030;

        TouchArea {
            enabled: parent.visible;
        }

        find-layout := VerticalLayout {
            padding: 8px;
            spacing: 6px;

            HorizontalLayout {
                spacing: 6px;
                height: 28px;

                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 6px;
                    background: Theme.hover;
                    border-width: 1px;
                    border-color: find-input.has-focus ? Theme.accent.with-alpha(0.5) : transparent;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;

                        find-input := TextInput {
                            horizontal-stretch: 1;
                            single-line: true;
                            vertical-alignment: center;
                            font-size: 13px;
                            color: Theme.ink;
                            selection-background-color: Theme.selection;
                            selection-foreground-color: Theme.ink;
                            edited => { root.find-edited(self.text); }
                            accepted => { root.find-step(1); }

                            Text {
                                width: 100%;
                                height: 100%;
                                visible: find-input.text.is-empty;
                                text: "Find";
                                color: Theme.muted;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            text: root.find-status;
                            color: root.find-status == "No results" ? Theme.danger : Theme.muted;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                }

                FindButton { icon: Icons.chevron-up; clicked => { root.find-step(-1); } }
                FindButton { icon: Icons.chevron-down; clicked => { root.find-step(1); } }
                FindButton { icon: Icons.replace; active: root.find-replace; clicked => { root.find-replace = !root.find-replace; } }
                FindButton {
                    icon: Icons.close;
                    clicked => {
                        root.find-open = false;
                        root.find-closed();
                    }
                }
            }

            if root.find-replace: HorizontalLayout {
                spacing: 6px;
                height: 28px;

                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 6px;
                    background: Theme.hover;
                    border-width: 1px;
                    border-color: replace-input.has-focus ? Theme.accent.with-alpha(0.5) : transparent;

                    replace-input := TextInput {
                        x: 8px;
                        width: parent.width - 16px;
                        single-line: true;
                        vertical-alignment: center;
                        font-size: 13px;
                        color: Theme.ink;
                        selection-background-color: Theme.selection;
                        selection-foreground-color: Theme.ink;
                        accepted => { root.replace-one(self.text); }

                        Text {
                            width: 100%;
                            height: 100%;
                            visible: replace-input.text.is-empty;
                            text: "Replace";
                            color: Theme.muted;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                    }
                }

                TextButton { label: "Replace"; clicked => { root.replace-one(replace-input.text); } }
                TextButton { label: "All"; clicked => { root.replace-all(replace-input.text); } }
            }
        }
    }

    // Shown when every note is closed: notes to jump back into, a new note or today's, and a tip.
    if !root.has-note: HorizontalLayout {
        alignment: center;

        VerticalLayout {
            width: min(380px, root.width - 48px);
            alignment: center;
            spacing: 18px;

            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "Nothing open";
                    color: Theme.heading;
                    font-family: Theme.heading-font;
                    font-size: 22px;
                    font-weight: 700;
                }
                Text {
                    text: "Pick up where you left off, or start something new.";
                    color: Theme.muted;
                    font-size: 13px;
                    wrap: word-wrap;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                for action[i] in [
                    { label: "New note", keys: "Ctrl+N", icon: Icons.plus },
                    { label: "Today\u{2019}s note", keys: "Ctrl+D", icon: Icons.edit },
                ]: Rectangle {
                    height: 34px;
                    width: action-row.preferred-width + 24px;
                    border-radius: 8px;
                    background: action-touch.has-hover ? Theme.selected : Theme.hover;
                    animate background { duration: 120ms; }
                    accessible-role: button;
                    accessible-label: action.label;
                    accessible-action-default => { if (i == 0) { root.new-note(); } else { root.open-daily(); } }

                    action-row := HorizontalLayout {
                        x: 12px;
                        width: self.preferred-width;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                width: 13px;
                                height: 13px;
                                commands: action.icon;
                                stroke: Theme.ink-soft;
                            }
                        }
                        Text {
                            text: action.label;
                            color: Theme.ink;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: action.keys;
                            color: Theme.muted;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }

                    action-touch := TouchArea {
                        clicked => { if (i == 0) { root.new-note(); } else { root.open-daily(); } }
                    }
                }
            }

            if root.recent-notes.length > 0: VerticalLayout {
                spacing: 2px;
                Text {
                    text: "RECENT";
                    color: Theme.muted;
                    font-size: 11px;
                    font-weight: 600;
                    letter-spacing: 1px;
                }
                for note in root.recent-notes: Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: recent-touch.has-hover ? Theme.hover : transparent;
                    accessible-role: button;
                    accessible-label: "Open " + note.title;
                    accessible-action-default => { root.open-note(note.id); }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        Text {
                            horizontal-stretch: 1;
                            text: note.title;
                            color: Theme.ink;
                            font-size: 13px;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        Text {
                            text: note.meta;
                            color: Theme.muted;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }

                    recent-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.open-note(note.id); }
                    }
                }
            }

            Text {
                text: "Tip: Ctrl+K finds any note or command.";
                color: Theme.muted;
                font-size: 12px;
            }
        }
    }
}
