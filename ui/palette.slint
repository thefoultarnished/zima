import { Theme } from "theme.slint";
import { Icon, Icons } from "widgets.slint";

export struct PaletteItem {
    title: string,
    subtitle: string,
    // "note", "command" or "heading".
    kind: string,
    shortcut: string,
    // A note's emoji; shown instead of the icon when set.
    emoji: string,
    // For commands: which icon (a name from `Icons`, see `icon-for`); empty for the default.
    icon: string,
}

// Quick switcher (Ctrl+K): type to find notes and commands.
export component QuickSwitcher {
    in property <[PaletteItem]> items;
    in property <string> placeholder;
    in-out property <int> index;
    // While false, nothing here reacts to the mouse.
    in property <bool> open;
    callback query(string);
    callback run(int);
    callback close();

    // A command's icon by name (set in Rust, `palette::icon`).
    pure function icon-for(name: string) -> string {
        return name == "plus" ? Icons.plus
            : name == "close" ? Icons.close
            : name == "star" ? Icons.star
            : name == "trash" ? Icons.trash
            : name == "restore" ? Icons.restore
            : name == "sidebar" ? Icons.sidebar
            : name == "search" ? Icons.search
            : name == "replace" ? Icons.replace
            : name == "timer" ? Icons.timer
            : name == "stop" ? Icons.stop
            : name == "bell" ? Icons.bell
            : name == "settings" ? Icons.settings
            : name == "edit" ? Icons.edit
            : name == "split" ? Icons.split
            : name == "eye" ? Icons.eye
            : name == "type" ? Icons.type
            : name == "bullets" ? Icons.bullets
            : name == "numbers" ? Icons.numbers
            : name == "task" ? Icons.task
            : name == "quote" ? Icons.quote
            : name == "keyboard" ? Icons.keyboard
            : name == "folder" ? Icons.folder
            : name == "export" ? Icons.export
            : name == "import" ? Icons.import
            : name == "check" ? Icons.check
            : Icons.chevron-right;
    }

    public function focus-input() {
        input.text = "";
        input.focus();
    }

    // Dim the window behind; clicking it closes.
    Rectangle {
        background: #00000040;
        TouchArea {
            enabled: root.open;
            clicked => { root.close(); }
        }
    }

    card := Rectangle {
        x: (root.width - self.width) / 2;
        y: 70px;
        width: min(560px, root.width - 48px);
        height: layout.preferred-height;
        border-radius: 14px;
        background: Theme.popover;
        border-width: 1px;
        border-color: Theme.rule;
        drop-shadow-blur: 32px;
        drop-shadow-offset-y: 12px;
        drop-shadow-color: #00000050;

        TouchArea {
            enabled: root.open;
        }

        layout := VerticalLayout {
            padding: 8px;
            spacing: 6px;

            HorizontalLayout {
                height: 40px;
                padding-left: 10px;
                padding-right: 10px;
                spacing: 10px;

                VerticalLayout {
                    alignment: center;
                    Icon {
                        width: 15px;
                        height: 15px;
                        commands: Icons.search;
                        stroke: Theme.muted;
                    }
                }

                // The switcher sits outside the app's key handler, so it handles its own keys.
                FocusScope {
                    horizontal-stretch: 1;
                    focus-on-click: false;
                    capture-key-pressed(event) => {
                        if (event.text == Key.UpArrow) {
                            root.index = Math.max(0, root.index - 1);
                            return accept;
                        }
                        if (event.text == Key.DownArrow) {
                            root.index = Math.min(root.items.length - 1, root.index + 1);
                            return accept;
                        }
                        if (event.text == Key.Escape) {
                            root.close();
                            return accept;
                        }
                        return reject;
                    }

                    input := TextInput {
                        single-line: true;
                        vertical-alignment: center;
                        font-size: 16px;
                        color: Theme.ink;
                        selection-background-color: Theme.selection;
                        selection-foreground-color: Theme.ink;
                        edited => { root.query(self.text); }
                        accepted => { root.run(root.index); }

                        Text {
                            width: 100%;
                            height: 100%;
                            visible: input.text.is-empty;
                            text: root.placeholder;
                            color: Theme.muted;
                            font-size: 16px;
                            vertical-alignment: center;
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: esc.preferred-width + 12px;
                        height: 20px;
                        border-radius: 5px;
                        border-width: 1px;
                        border-color: Theme.rule;
                        esc := Text {
                            text: "Esc";
                            color: Theme.muted;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.rule;
            }

            if root.items.length == 0: Text {
                height: 44px;
                text: input.text.is-empty ? "Start typing\u{2026}" : "Nothing found";
                color: Theme.muted;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // Up to 9 rows visible; the selection scrolls with arrow keys.
            property <int> visible-rows: Math.min(9, root.items.length);
            property <int> first: Math.max(0, Math.min(root.index - 4, root.items.length - self.visible-rows));

            VerticalLayout {
                spacing: 1px;
                for row in parent.visible-rows: entry := Rectangle {
                    property <int> i: layout.first + row;
                    property <PaletteItem> item: root.items[self.i];
                    height: 38px;
                    border-radius: 8px;
                    background: self.i == root.index ? Theme.selected : row-touch.has-hover ? Theme.hover : transparent;

                    row-touch := TouchArea {
                        enabled: root.open;
                        clicked => { root.run(entry.i); }
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 12px;
                        spacing: 10px;

                        VerticalLayout {
                            alignment: center;
                            if entry.item.emoji == "": Icon {
                                width: 14px;
                                height: 14px;
                                commands: entry.item.kind == "command" ? root.icon-for(entry.item.icon)
                                    : entry.item.kind == "heading" ? Icons.quote : Icons.edit;
                                stroke: Theme.muted;
                            }
                            if entry.item.emoji != "": Text {
                                width: 14px;
                                text: entry.item.emoji;
                                font-family: "Segoe UI Emoji";
                                font-size: 14px;
                                color: Theme.ink-soft;
                                horizontal-alignment: center;
                            }
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: entry.item.title;
                            overflow: elide;
                            color: Theme.ink;
                            font-size: 14px;
                            vertical-alignment: center;
                        }

                        Text {
                            text: entry.item.shortcut != "" ? entry.item.shortcut : entry.item.subtitle;
                            color: Theme.muted;
                            font-size: 11.5px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
