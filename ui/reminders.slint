import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icon, IconButton, Icons } from "widgets.slint";

export struct ReminderRow {
    id: string,
    text: string,
    due: string,
}

component ReminderItem {
    in property <ReminderRow> reminder;
    callback delete();
    callback open();

    height: 48px;

    // The delete button's own TouchArea takes the hover from the row's, so combine both;
    // otherwise the button fades out as soon as the mouse reaches it.
    property <bool> hovered: touch.has-hover || delete-button.has-hover;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(); }
    }

    Rectangle {
        border-radius: 8px;
        background: root.hovered ? Theme.hover : transparent;
        animate background { duration: 120ms; }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 4px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 13px;
                background: Theme.accent.with-alpha(0.15);

                Icon {
                    width: 13px;
                    height: 13px;
                    commands: Icons.bell;
                    stroke: Theme.accent;
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;

            Text {
                text: root.reminder.text;
                overflow: elide;
                color: Theme.ink;
                font-size: 13px;
                font-weight: 500;
            }

            Text {
                text: root.reminder.due;
                color: Theme.muted;
                font-size: 11px;
            }
        }

        VerticalLayout {
            alignment: center;
            delete-button := IconButton {
                opacity: root.hovered ? 1 : 0;
                size: 24px;
                icon-size: 12px;
                description: "Delete reminder";
                icon: Icons.close;
                hover-color: Theme.danger;
                clicked => {
                    root.delete();
                }
            }
        }
    }
}

export component ReminderPopover {
    in property <[ReminderRow]> reminders;
    callback delete-reminder(string);
    callback open-reminder(string);

    width: 300px;

    // Swallow clicks so they don't reach the "click outside to close" area behind.
    TouchArea { }

    Rectangle {
        border-radius: 12px;
        background: Theme.popover;
        border-width: 1px;
        border-color: Theme.rule;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #00000040;
    }

    VerticalLayout {
        padding: 10px;
        spacing: 6px;

        HorizontalLayout {
            padding-left: 6px;
            padding-right: 4px;
            height: 26px;

            Text {
                text: "Reminders";
                color: Theme.ink;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            if root.reminders.length > 0: Rectangle {
                width: count.preferred-width + 14px;
                height: 18px;
                y: (parent.height - self.height) / 2;
                border-radius: 9px;
                background: Theme.hover;

                count := Text {
                    text: root.reminders.length;
                    color: Theme.ink-soft;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        if root.reminders.length == 0: VerticalLayout {
            padding-top: 14px;
            padding-bottom: 16px;
            spacing: 6px;

            Text {
                text: "No reminders";
                color: Theme.ink-soft;
                font-size: 13px;
                horizontal-alignment: center;
            }

            Text {
                text: "Type \u{201c}@remind me to stretch in 20 min\u{201d}\nin a note and press Enter.";
                color: Theme.muted;
                font-size: 11.5px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        if root.reminders.length > 0: ScrollView {
            height: min(root.reminders.length * 48px, 6 * 48px);

            VerticalLayout {
                for reminder in root.reminders: ReminderItem {
                    reminder: reminder;
                    delete => {
                        root.delete-reminder(reminder.id);
                    }
                    open => {
                        root.open-reminder(reminder.id);
                    }
                }
            }
        }
    }
}

// A message that slides in under the title bar and fades out, optionally with buttons.
export component Toast {
    in property <string> text;
    in property <bool> error;
    in property <bool> shown;
    in property <[string]> actions;
    callback action(int);

    width: min(560px, row.preferred-width);
    height: 40px;
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: 200ms; }

    Rectangle {
        y: root.shown ? 0 : 8px;
        animate y { duration: 200ms; easing: ease-out; }
        border-radius: 10px;
        background: Theme.ink;
        drop-shadow-blur: 18px;
        drop-shadow-offset-y: 6px;
        drop-shadow-color: #00000035;

        // Only clickable while shown.
        TouchArea {
            enabled: root.shown;
        }

        row := HorizontalLayout {
            padding-left: 14px;
            padding-right: root.actions.length > 0 ? 6px : 16px;
            spacing: 10px;

            VerticalLayout {
                alignment: center;
                Icon {
                    width: 14px;
                    height: 14px;
                    commands: root.error ? Icons.alert : Icons.bell;
                    stroke: root.error ? Theme.danger : Theme.accent;
                }
            }

            label := Text {
                text: root.text;
                overflow: elide;
                color: Theme.paper;
                font-size: 13px;
                vertical-alignment: center;
            }

            for action-label[i] in root.actions: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: action-text.preferred-width + 16px;
                    height: 26px;
                    border-radius: 7px;
                    background: action-touch.pressed ? Theme.paper.with-alpha(0.3) : action-touch.has-hover ? Theme.paper.with-alpha(0.22) : Theme.paper.with-alpha(0.12);

                    action-text := Text {
                        text: action-label;
                        color: Theme.paper;
                        font-size: 12px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    action-touch := TouchArea {
                        enabled: root.shown;
                        clicked => { root.action(i); }
                    }
                }
            }
        }
    }
}
