import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icon, Icons, Slider, Toggle } from "widgets.slint";

component SectionLabel inherits Text {
    color: Theme.muted;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 1.1px;
}

component SettingRow {
    in property <string> label;
    in property <string> detail;
    in-out property <bool> checked;
    callback toggled(bool);

    min-height: root.detail != "" ? 44px : 34px;

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 10px;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: root.label;
                color: Theme.ink;
                font-size: 13px;
                wrap: word-wrap;
            }
            if root.detail != "": Text {
                text: root.detail;
                color: Theme.muted;
                font-size: 11px;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;
            Toggle {
                checked <=> root.checked;
                description: root.label;
                toggled(on) => { root.toggled(on); }
            }
        }
    }
}

component ActionRow {
    in property <string> icon;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();

    height: 32px;
    opacity: root.enabled ? 1 : 0.4;

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    Rectangle {
        border-radius: 7px;
        background: touch.has-hover ? Theme.hover : transparent;
    }

    HorizontalLayout {
        padding-left: 6px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            Icon {
                width: 14px;
                height: 14px;
                commands: root.icon;
                stroke: Theme.ink-soft;
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: Theme.ink;
            font-size: 13px;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

export component SettingsPopover {
    in-out property <bool> wide;
    in-out property <bool> zen;
    in-out property <bool> typewriter;
    in-out property <bool> spotlight;
    in-out property <bool> launch-at-login;
    in-out property <bool> software-rendering;
    in property <bool> has-note;

    callback set-theme(int);
    // "#rrggbb", or "" for the theme's own accent.
    callback set-accent(string);
    callback set-font(string);
    callback set-transparency(float);
    callback set-wide(bool);
    callback set-zen(bool);
    callback set-typewriter(bool);
    in property <string> clip-token;
    callback copy-clip-token();
    in property <string> sync-location;
    in property <bool> sync-active;
    in property <string> google-drive-path;
    callback use-google-drive();
    callback choose-sync-folder();
    callback stop-syncing();
    callback import-markdown-folder();
    callback export-all();
    callback zoom(int);
    callback set-line-spacing(float);
    callback step-ui-scale(int);
    callback set-spotlight(bool);
    callback set-launch-at-login(bool);
    callback set-software-rendering(bool);
    callback export-note();
    callback import-zima();
    callback open-notes-folder();
    callback open-shortcuts();
    callback edit-theme();

    in property <length> limit-height: 600px;
    width: 320px;
    height: min(content.preferred-height, root.limit-height);

    // Swallow clicks so they don't reach the "click outside to close" area behind.
    TouchArea { }

    Rectangle {
        border-radius: 12px;
        background: Theme.popover;
        border-width: 1px;
        border-color: Theme.rule;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #00000040;
    }

    // Scrolls when taller than the window.
    // Scrolls up and down only: the content is always exactly as wide as the panel.
    scroll := ScrollView {
        content-width: scroll.visible-width;
        content := VerticalLayout {
        width: scroll.visible-width;
        padding: 14px;
        spacing: 10px;

        SectionLabel { text: "THEME"; }

        // Theme swatches, three per row.
        VerticalLayout {
            spacing: 8px;
            for row in [0, 1, 2, 3]: HorizontalLayout {
                spacing: 8px;
                for col in [0, 1, 2]: cell := Rectangle {
                    property <int> index: row * 3 + col;
                    property <bool> selected: Theme.selected-theme == self.index;
                    visible: self.index < Theme.themes.length;
                    height: 58px;
                    horizontal-stretch: 1;

                    swatch-touch := TouchArea {
                        clicked => { root.set-theme(cell.index); }
                    }

                    VerticalLayout {
                        spacing: 5px;
                        Rectangle {
                            height: 36px;
                            border-radius: 8px;
                            background: Theme.themes[cell.index].swatch;
                            border-width: cell.selected ? 2px : 1px;
                            border-color: cell.selected ? Theme.accent : swatch-touch.has-hover ? Theme.muted : Theme.rule;

                            Rectangle {
                                x: parent.width - 16px;
                                y: 6px;
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: Theme.themes[cell.index].accent;
                            }
                        }
                        Text {
                            text: Theme.themes[cell.index].name;
                            overflow: elide;
                            color: cell.selected ? Theme.ink : Theme.ink-soft;
                            font-size: 11.5px;
                            font-weight: cell.selected ? 600 : 400;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }

        SectionLabel { text: "ACCENT"; }

        HorizontalLayout {
            alignment: space-between;

            // Theme default.
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 11px;
                background: @linear-gradient(135deg, #c8794a 0%, #c8794a 50%, #12b5e5 50%, #12b5e5 100%);
                border-width: !Theme.has-custom-accent ? 2px : 0;
                border-color: Theme.ink;
                TouchArea {
                    clicked => { root.set-accent(""); }
                }
            }

            for swatch[i] in Theme.accent-choices: Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 11px;
                background: swatch;
                border-width: Theme.has-custom-accent && Theme.custom-accent == swatch ? 2px : 0;
                border-color: Theme.ink;
                TouchArea {
                    clicked => { root.set-accent(Theme.accent-hexes[i]); }
                }
            }
        }

        SectionLabel { text: "FONT"; }

        HorizontalLayout {
            spacing: 6px;
            for font[i] in Theme.fonts: Rectangle {
                property <bool> selected: Theme.font == font;
                height: 34px;
                horizontal-stretch: 1;
                border-radius: 8px;
                background: self.selected ? Theme.selected : font-touch.has-hover ? Theme.hover : transparent;
                border-width: 1px;
                border-color: self.selected ? Theme.accent.with-alpha(0.6) : Theme.rule;

                font-touch := TouchArea {
                    clicked => { root.set-font(font); }
                }

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Aa";
                        font-family: font;
                        font-size: 14px;
                        color: Theme.ink;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: Theme.font-labels[i];
                        font-size: 9.5px;
                        color: Theme.muted;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        SectionLabel { text: "TEXT"; }

        HorizontalLayout {
            spacing: 8px;
            height: 30px;

            // Size: − 100% +
            Rectangle {
                width: 112px;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.rule;
                HorizontalLayout {
                    TouchArea {
                        width: 34px;
                        clicked => { root.zoom(-1); }
                        Text { text: "A\u{2212}"; color: Theme.ink-soft; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: Math.round(Theme.text-scale * 100) + "%";
                        color: Theme.ink;
                        font-size: 11.5px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        width: 34px;
                        clicked => { root.zoom(1); }
                        Text { text: "A+"; color: Theme.ink-soft; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }

            // Line spacing.
            for option[i] in [{ label: "Compact", value: 1.0 }, { label: "Normal", value: 1.25 }, { label: "Airy", value: 1.6 }]: Rectangle {
                property <bool> selected: Math.abs(Theme.line-spacing - option.value) < 0.01;
                horizontal-stretch: 1;
                border-radius: 8px;
                background: self.selected ? Theme.selected : spacing-touch.has-hover ? Theme.hover : transparent;
                border-width: 1px;
                border-color: self.selected ? Theme.accent.with-alpha(0.6) : Theme.rule;
                spacing-touch := TouchArea {
                    clicked => { root.set-line-spacing(option.value); }
                }
                Text {
                    text: option.label;
                    color: Theme.ink-soft;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        SectionLabel { text: "INTERFACE SIZE"; }

        HorizontalLayout {
            spacing: 10px;
            height: 30px;

            // Size: − 100% +
            Rectangle {
                width: 112px;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.rule;
                HorizontalLayout {
                    TouchArea {
                        width: 34px;
                        clicked => { root.step-ui-scale(-1); }
                        Text { text: "\u{2212}"; color: Theme.ink-soft; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: Math.round(Theme.ui-scale * 100) + "%";
                        color: Theme.ink;
                        font-size: 11.5px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        width: 34px;
                        clicked => { root.step-ui-scale(1); }
                        Text { text: "+"; color: Theme.ink-soft; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }

            Text {
                horizontal-stretch: 1;
                text: "Makes icons, buttons and text bigger or smaller.";
                color: Theme.muted;
                font-size: 11px;
                wrap: word-wrap;
                vertical-alignment: center;
            }
        }

        SectionLabel { text: "TRANSPARENCY"; }

        HorizontalLayout {
            spacing: 10px;
            padding-left: 2px;
            padding-right: 2px;
            Slider {
                horizontal-stretch: 1;
                minimum: 0.3;
                maximum: 1.0;
                // Two-way, so the window and the label update in the same frame as the drag
                // (and the binding survives the slider writing its own value).
                value <=> Theme.surface-alpha;
                description: "Window opacity";
                changed(v) => { root.set-transparency(v); }
            }
            Text {
                width: 34px;
                text: Math.round(Theme.surface-alpha * 100) + "%";
                color: Theme.muted;
                font-size: 11px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        Rectangle { height: 1px; background: Theme.rule; }

        VerticalLayout {
            SettingRow {
                label: "Wide layout";
                checked <=> root.wide;
                toggled(on) => { root.set-wide(on); }
            }
            SettingRow {
                label: "Zen mode";
                detail: "Ctrl+Shift+Z · Esc to leave";
                checked <=> root.zen;
                toggled(on) => { root.set-zen(on); }
            }
            SettingRow {
                label: "Typewriter scrolling";
                detail: "In zen mode, keep the line you're on centred";
                checked <=> root.typewriter;
                toggled(on) => { root.set-typewriter(on); }
            }
            SettingRow {
                label: "Spotlight";
                detail: "In zen mode, fade the text above and below you";
                checked <=> root.spotlight;
                toggled(on) => { root.set-spotlight(on); }
            }
            SettingRow {
                label: "Launch at login";
                detail: "Starts in the tray so reminders fire";
                checked <=> root.launch-at-login;
                toggled(on) => { root.set-launch-at-login(on); }
            }
            SettingRow {
                label: "Low-memory rendering";
                detail: "Draw with the CPU, not the GPU: ~90 MB less memory. Restart needed";
                checked <=> root.software-rendering;
                toggled(on) => { root.set-software-rendering(on); }
            }
        }

        Rectangle { height: 1px; background: Theme.rule; }

        SectionLabel { text: "SYNC"; }

        VerticalLayout {
            spacing: 6px;
            Text {
                text: (root.sync-active ? "Synced folder: " : "Notes are stored on this PC: ") + root.sync-location;
                color: Theme.ink-soft;
                font-size: 11.5px;
                wrap: word-wrap;
            }
            if !root.sync-active: Text {
                text: root.google-drive-path != ""
                    ? "Google Drive found at " + root.google-drive-path + ". Your notes will go in a \u{201c}Zima\u{201d} folder there and sync to your other devices."
                    : "Install Google Drive for desktop to sync with Google Drive, or pick any synced folder (OneDrive, Dropbox).";
                color: Theme.muted;
                font-size: 11px;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            if !root.sync-active && root.google-drive-path != "": ActionRow {
                icon: Icons.folder;
                label: "Use Google Drive";
                clicked => { root.use-google-drive(); }
            }
            ActionRow {
                icon: Icons.folder;
                label: root.sync-active ? "Move to another folder…" : "Choose a synced folder…";
                clicked => { root.choose-sync-folder(); }
            }
            if root.sync-active: ActionRow {
                icon: Icons.restore;
                label: "Stop syncing (keep notes on this PC)";
                clicked => { root.stop-syncing(); }
            }
        }

        Rectangle { height: 1px; background: Theme.rule; }

        SectionLabel { text: "WEB CLIPPER"; }

        VerticalLayout {
            spacing: 6px;
            Text {
                text: "Send pages and selections from Chrome or Edge to Zima. Load the \u{201c}clipper\u{201d} folder (in the Zima project) at chrome://extensions with Developer mode on (\u{201c}Load unpacked\u{201d}), then paste this token into its popup:";
                color: Theme.muted;
                font-size: 11px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 6px;
                Rectangle {
                    horizontal-stretch: 1;
                    height: 28px;
                    border-radius: 6px;
                    background: Theme.hover;
                    Text {
                        x: 8px;
                        text: root.clip-token;
                        color: Theme.ink;
                        font-family: "JetBrains Mono";
                        font-size: 11.5px;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                }
                Rectangle {
                    width: copy-label.preferred-width + 18px;
                    height: 28px;
                    border-radius: 6px;
                    background: copy-touch.has-hover ? Theme.selected : Theme.hover;
                    copy-label := Text {
                        text: "Copy";
                        color: Theme.ink-soft;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    copy-touch := TouchArea {
                        clicked => { root.copy-clip-token(); }
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.rule; }

        VerticalLayout {
            ActionRow {
                icon: Icons.export;
                label: "Export all notes as a zip…";
                clicked => { root.export-all(); }
            }
            ActionRow {
                icon: Icons.import;
                label: "Import a folder of Markdown notes…";
                clicked => { root.import-markdown-folder(); }
            }
            ActionRow {
                icon: Icons.export;
                label: "Export note as Markdown…";
                enabled: root.has-note;
                clicked => { root.export-note(); }
            }
            ActionRow {
                icon: Icons.import;
                label: "Import from Zima…";
                clicked => { root.import-zima(); }
            }
            ActionRow {
                icon: Icons.edit;
                label: "Edit custom theme…";
                clicked => { root.edit-theme(); }
            }
            ActionRow {
                icon: Icons.keyboard;
                label: "Keyboard shortcuts…";
                clicked => { root.open-shortcuts(); }
            }
            ActionRow {
                icon: Icons.folder;
                label: "Open notes folder";
                clicked => { root.open-notes-folder(); }
            }
        }
    }
    }
}
