import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icon, IconButton, Icons, Slider, Toggle } from "widgets.slint";
import { ShortcutsEditor, ShortcutRow } from "shortcuts.slint";

component SectionLabel inherits Text {
    color: Theme.muted;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 1.1px;
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.rule;
}

component SettingRow {
    in property <string> label;
    in property <string> detail;
    in-out property <bool> checked;
    callback toggled(bool);

    min-height: root.detail != "" ? 44px : 34px;

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 10px;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: root.label;
                color: Theme.ink;
                font-size: 13px;
                wrap: word-wrap;
            }
            if root.detail != "": Text {
                text: root.detail;
                color: Theme.muted;
                font-size: 11px;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;
            Toggle {
                checked <=> root.checked;
                description: root.label;
                toggled(on) => { root.toggled(on); }
            }
        }
    }
}

component ActionRow {
    in property <string> icon;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();

    height: 32px;
    opacity: root.enabled ? 1 : 0.4;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    Rectangle {
        border-radius: 7px;
        background: touch.has-hover ? Theme.hover : transparent;
    }

    HorizontalLayout {
        padding-left: 6px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            Icon {
                width: 14px;
                height: 14px;
                commands: root.icon;
                stroke: Theme.ink-soft;
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: Theme.ink;
            font-size: 13px;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

// Muted help text under a setting.
component Hint inherits Text {
    color: Theme.muted;
    font-size: 11px;
    wrap: word-wrap;
}

// − 100% + stepper, used for text size and interface size.
component Stepper {
    in property <string> value;
    in property <string> minus-text;
    in property <string> plus-text;
    in property <length> minus-size: 14px;
    in property <length> plus-size: 14px;
    in property <string> description;
    callback step(int);

    width: 112px;
    height: 30px;

    Rectangle {
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.rule;
    }

    HorizontalLayout {
        TouchArea {
            width: 34px;
            accessible-role: button;
            accessible-label: root.description + ": smaller";
            accessible-action-default => { root.step(-1); }
            clicked => { root.step(-1); }
            Text { text: root.minus-text; color: Theme.ink-soft; font-size: root.minus-size; horizontal-alignment: center; vertical-alignment: center; }
        }
        Text {
            horizontal-stretch: 1;
            text: root.value;
            color: Theme.ink;
            font-size: 11.5px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea {
            width: 34px;
            accessible-role: button;
            accessible-label: root.description + ": bigger";
            accessible-action-default => { root.step(1); }
            clicked => { root.step(1); }
            Text { text: root.plus-text; color: Theme.ink-soft; font-size: root.plus-size; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
}

// Theme swatches in a grid.
component ThemePicker {
    in property <int> columns: 3;
    callback pick(int);

    // Fixed, so a long theme name doesn't make its swatch wider than the others.
    property <length> cell-width: (root.width - (root.columns - 1) * 8px) / root.columns;

    VerticalLayout {
        spacing: 8px;
        for line in Math.ceil(Theme.themes.length / root.columns): HorizontalLayout {
            spacing: 8px;
            for col in root.columns: cell := Rectangle {
                property <int> index: line * root.columns + col;
                property <bool> selected: Theme.selected-theme == self.index;
                visible: self.index < Theme.themes.length;
                width: root.cell-width;
                height: 58px;
                accessible-role: button;
                accessible-label: self.visible ? "Theme: " + Theme.themes[self.index].name : "";
                accessible-action-default => { root.pick(cell.index); }

                swatch-touch := TouchArea {
                    enabled: cell.visible;
                    clicked => { root.pick(cell.index); }
                }

                VerticalLayout {
                    spacing: 5px;
                    Rectangle {
                        height: 36px;

                        if Theme.themes[cell.index].picture.width == 0: Rectangle {
                            border-radius: 8px;
                            background: Theme.themes[cell.index].swatch;
                        }
                        if Theme.themes[cell.index].picture.width > 0: Image {
                            width: parent.width;
                            height: parent.height;
                            source: Theme.themes[cell.index].picture;
                            image-fit: fill;
                        }
                        // The outline on top, so the picture doesn't cover it.
                        Rectangle {
                            border-radius: 8px;
                            border-width: cell.selected ? 2px : 1px;
                            border-color: cell.selected ? Theme.accent : swatch-touch.has-hover ? Theme.muted : Theme.rule;
                        }

                        Rectangle {
                            x: parent.width - 16px;
                            y: 6px;
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: Theme.themes[cell.index].accent;
                        }
                    }
                    Text {
                        text: Theme.themes[cell.index].name;
                        overflow: elide;
                        color: cell.selected ? Theme.ink : Theme.ink-soft;
                        font-size: 11.5px;
                        font-weight: cell.selected ? 600 : 400;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}

component AccentPicker {
    // "#rrggbb", or "" for the theme's own accent.
    callback pick(string);

    HorizontalLayout {
        alignment: space-between;

        // Theme default. A picture, not a gradient: the CPU renderer draws gradients without round corners.
        Rectangle {
            width: 22px;
            height: 22px;
            accessible-role: button;
            accessible-label: "Theme's own accent";
            accessible-action-default => { root.pick(""); }
            Image {
                width: parent.width;
                height: parent.height;
                source: @image-url("swatches/accent-default.svg");
            }
            Rectangle {
                border-radius: 11px;
                border-width: !Theme.has-custom-accent ? 2px : 0;
                border-color: Theme.ink;
            }
            TouchArea {
                clicked => { root.pick(""); }
            }
        }

        for swatch[i] in Theme.accent-choices: Rectangle {
            width: 22px;
            height: 22px;
            border-radius: 11px;
            background: swatch;
            border-width: Theme.has-custom-accent && Theme.custom-accent == swatch ? 2px : 0;
            border-color: Theme.ink;
            accessible-role: button;
            accessible-label: "Accent " + Theme.accent-hexes[i];
            accessible-action-default => { root.pick(Theme.accent-hexes[i]); }
            TouchArea {
                clicked => { root.pick(Theme.accent-hexes[i]); }
            }
        }
    }
}

component FontPicker {
    callback pick(string);

    HorizontalLayout {
        spacing: 6px;
        for font[i] in Theme.fonts: Rectangle {
            property <bool> selected: Theme.font == font;
            height: 34px;
            horizontal-stretch: 1;
            border-radius: 8px;
            background: self.selected ? Theme.selected : font-touch.has-hover ? Theme.hover : transparent;
            border-width: 1px;
            border-color: self.selected ? Theme.accent.with-alpha(0.6) : Theme.rule;
            accessible-role: button;
            accessible-label: "Font: " + Theme.font-labels[i];
            accessible-action-default => { root.pick(font); }

            font-touch := TouchArea {
                clicked => { root.pick(font); }
            }

            VerticalLayout {
                alignment: center;
                Text {
                    text: "Aa";
                    font-family: font;
                    font-size: 14px;
                    color: Theme.ink;
                    horizontal-alignment: center;
                }
                Text {
                    text: Theme.font-labels[i];
                    font-size: 9.5px;
                    color: Theme.muted;
                    horizontal-alignment: center;
                }
            }
        }
    }
}

// Text size and line spacing.
component TextControls {
    callback zoom(int);
    callback set-line-spacing(float);

    HorizontalLayout {
        spacing: 8px;
        height: 30px;

        Stepper {
            value: Math.round(Theme.text-scale * 100) + "%";
            minus-text: "A\u{2212}";
            minus-size: 12px;
            plus-text: "A+";
            description: "Text size";
            step(delta) => { root.zoom(delta); }
        }

        for option in [{ name: "Compact", value: 1.0 }, { name: "Normal", value: 1.25 }, { name: "Airy", value: 1.6 }]: Rectangle {
            property <bool> selected: Math.abs(Theme.line-spacing - option.value) < 0.01;
            horizontal-stretch: 1;
            border-radius: 8px;
            background: self.selected ? Theme.selected : spacing-touch.has-hover ? Theme.hover : transparent;
            border-width: 1px;
            border-color: self.selected ? Theme.accent.with-alpha(0.6) : Theme.rule;
            accessible-role: button;
            accessible-label: "Line spacing: " + option.name;
            accessible-action-default => { root.set-line-spacing(option.value); }
            spacing-touch := TouchArea {
                clicked => { root.set-line-spacing(option.value); }
            }
            Text {
                text: option.name;
                color: Theme.ink-soft;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// Quick settings under the gear button. Everything else is in the settings window.
export component SettingsPopover {
    in-out property <bool> wide;
    in-out property <bool> zen;

    callback set-theme(int);
    // "#rrggbb", or "" for the theme's own accent.
    callback set-accent(string);
    callback set-wide(bool);
    callback set-zen(bool);
    callback zoom(int);
    callback set-line-spacing(float);
    callback open-all();

    in property <length> limit-height: 600px;
    width: 320px;
    height: min(content.preferred-height, root.limit-height);

    // Swallow clicks so they don't reach the "click outside to close" area behind.
    TouchArea { }

    Rectangle {
        border-radius: 12px;
        background: Theme.popover;
        border-width: 1px;
        border-color: Theme.rule;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #00000040;
    }

    // Scrolls up and down only when taller than the window: the content is always exactly as wide as the panel.
    scroll := ScrollView {
        content-width: scroll.visible-width;
        content := VerticalLayout {
            width: scroll.visible-width;
            padding: 14px;
            spacing: 10px;

            SectionLabel { text: "THEME"; }
            ThemePicker {
                pick(index) => { root.set-theme(index); }
            }

            SectionLabel { text: "ACCENT"; }
            AccentPicker {
                pick(hex) => { root.set-accent(hex); }
            }

            SectionLabel { text: "TEXT"; }
            TextControls {
                zoom(step) => { root.zoom(step); }
                set-line-spacing(value) => { root.set-line-spacing(value); }
            }

            Divider { }

            VerticalLayout {
                SettingRow {
                    label: "Wide layout";
                    checked <=> root.wide;
                    toggled(on) => { root.set-wide(on); }
                }
                SettingRow {
                    label: "Zen mode";
                    detail: "Ctrl+Shift+Z · Esc to leave";
                    checked <=> root.zen;
                    toggled(on) => { root.set-zen(on); }
                }
            }

            Divider { }

            ActionRow {
                icon: Icons.settings;
                label: "All settings\u{2026}";
                clicked => { root.open-all(); }
            }
        }
    }
}

// A page in the settings window's list.
component PageButton {
    in property <string> icon;
    in property <string> title;
    in property <bool> selected;
    callback clicked();

    height: 34px;
    accessible-role: tab;
    accessible-label: root.title;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Rectangle {
        border-radius: 8px;
        background: root.selected ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            Icon {
                width: 14px;
                height: 14px;
                commands: root.icon;
                stroke: root.selected ? Theme.accent : Theme.ink-soft;
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.title;
            color: root.selected ? Theme.ink : Theme.ink-soft;
            font-size: 13px;
            font-weight: root.selected ? 600 : 400;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

struct SettingsPage {
    id: string,
    title: string,
    icon: string,
}

// Every setting, one page at a time. A new setting goes on the page it fits; a new page goes in `pages`.
export component SettingsWindow {
    // Id of the page shown, from `pages`.
    in-out property <string> page: "appearance";
    changed page => { root.clear-armed = false; }

    in-out property <bool> wide;
    in-out property <bool> zen;
    in-out property <bool> typewriter;
    in-out property <bool> spotlight;
    in-out property <bool> launch-at-login;
    in-out property <bool> software-rendering;
    in-out property <bool> close-to-tray;
    in-out property <bool> version-history;
    // "Clear history" was clicked once; the second click deletes.
    property <bool> clear-armed;
    in property <bool> has-note;
    in property <string> sync-location;
    in property <bool> sync-active;
    in property <string> google-drive-path;
    in property <[ShortcutRow]> shortcut-rows;

    callback set-theme(int);
    // "#rrggbb", or "" for the theme's own accent.
    callback set-accent(string);
    callback set-font(string);
    callback set-transparency(float);
    callback zoom(int);
    callback set-line-spacing(float);
    callback step-ui-scale(int);
    callback set-wide(bool);
    callback set-typewriter(bool);
    callback set-spotlight(bool);
    callback set-close-to-tray(bool);
    callback set-version-history(bool);
    callback set-launch-at-login(bool);
    callback set-software-rendering(bool);
    callback use-google-drive();
    callback choose-sync-folder();
    callback stop-syncing();
    callback export-all();
    callback import-markdown-folder();
    callback export-note();
    callback import-zima();
    callback open-notes-folder();
    callback open-backups-folder();
    callback set-shortcut(string, string);
    callback reset-shortcut(string);
    callback shortcut-filter-edited(string);
    // Quick-switcher commands without a callback of their own ("edit-theme", "backup").
    callback run-command(string);
    callback close();

    property <[SettingsPage]> pages: [
        { id: "appearance", title: "Appearance", icon: Icons.eye },
        { id: "writing", title: "Writing", icon: Icons.type },
        { id: "general", title: "General", icon: Icons.settings },
        { id: "sync", title: "Sync and backups", icon: Icons.folder },
        { id: "files", title: "Import and export", icon: Icons.export },
        { id: "shortcuts", title: "Keyboard shortcuts", icon: Icons.keyboard },
    ];

    init => { keys.focus(); }

    // Swallow clicks so they don't reach the dimmed area behind, which closes the window.
    TouchArea { }

    Rectangle {
        border-radius: 14px;
        background: Theme.popover;
        border-width: 1px;
        border-color: Theme.rule;
        drop-shadow-blur: 32px;
        drop-shadow-offset-y: 12px;
        drop-shadow-color: #00000050;
    }

    // Outside the app's own key handler, so Esc is handled here (the shortcut recorder sees it first).
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close();
                return accept;
            }
            return reject;
        }

        HorizontalLayout {
            // Page list.
            Rectangle {
                width: 200px;
                border-top-left-radius: 14px;
                border-bottom-left-radius: 14px;
                background: Theme.hover;

                VerticalLayout {
                    padding: 10px;
                    padding-top: 0;
                    spacing: 2px;
                    alignment: start;

                    HorizontalLayout {
                        height: 52px;
                        padding-left: 10px;
                        Text {
                            text: "Settings";
                            color: Theme.ink;
                            font-size: 15px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    for p in root.pages: PageButton {
                        icon: p.icon;
                        title: p.title;
                        selected: root.page == p.id;
                        clicked => { root.page = p.id; }
                    }
                }
            }

            Rectangle {
                width: 1px;
                background: Theme.rule;
            }

            // The page.
            VerticalLayout {
                horizontal-stretch: 1;

                HorizontalLayout {
                    height: 52px;
                    padding-left: 22px;
                    padding-right: 10px;
                    // The page's title; Slint can't look it up in `pages`, so all are built and one is shown.
                    Rectangle {
                        horizontal-stretch: 1;
                        for p in root.pages: Text {
                            width: parent.width;
                            height: parent.height;
                            visible: p.id == root.page;
                            text: p.title;
                            color: Theme.ink;
                            font-size: 15px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            description: "Close settings";
                            icon: Icons.close;
                            clicked => { root.close(); }
                        }
                    }
                }

                // Has its own filter box and scrolling list.
                if root.page == "shortcuts": ShortcutsEditor {
                    vertical-stretch: 1;
                    rows: root.shortcut-rows;
                    set-shortcut(id, combo) => { root.set-shortcut(id, combo); }
                    reset-shortcut(id) => { root.reset-shortcut(id); }
                    filter-edited(text) => { root.shortcut-filter-edited(text); }
                }

                if root.page != "shortcuts": scroll := ScrollView {
                    vertical-stretch: 1;
                    content-width: scroll.visible-width;

                    VerticalLayout {
                        width: scroll.visible-width;
                        padding-left: 22px;
                        padding-right: 22px;
                        padding-top: 4px;
                        padding-bottom: 20px;
                        spacing: 10px;
                        alignment: start;

                        if root.page == "appearance": VerticalLayout {
                            spacing: 10px;

                            SectionLabel { text: "THEME"; }
                            ThemePicker {
                                columns: 4;
                                pick(index) => { root.set-theme(index); }
                            }

                            SectionLabel { text: "ACCENT"; }
                            AccentPicker {
                                pick(hex) => { root.set-accent(hex); }
                            }

                            SectionLabel { text: "FONT"; }
                            FontPicker {
                                pick(font) => { root.set-font(font); }
                            }

                            SectionLabel { text: "INTERFACE SIZE"; }
                            HorizontalLayout {
                                spacing: 10px;
                                Stepper {
                                    value: Math.round(Theme.ui-scale * 100) + "%";
                                    minus-text: "\u{2212}";
                                    plus-text: "+";
                                    description: "Interface size";
                                    step(delta) => { root.step-ui-scale(delta); }
                                }
                                Hint {
                                    horizontal-stretch: 1;
                                    text: "Makes icons, buttons and text bigger or smaller.";
                                    vertical-alignment: center;
                                }
                            }

                            SectionLabel { text: "TRANSPARENCY"; }
                            HorizontalLayout {
                                spacing: 10px;
                                padding-left: 2px;
                                padding-right: 2px;
                                Slider {
                                    horizontal-stretch: 1;
                                    minimum: 0.3;
                                    maximum: 1.0;
                                    // Two-way, so the window and the label update in the same frame as the drag
                                    // (and the binding survives the slider writing its own value).
                                    value <=> Theme.surface-alpha;
                                    description: "Window opacity";
                                    changed(v) => { root.set-transparency(v); }
                                }
                                Text {
                                    width: 34px;
                                    text: Math.round(Theme.surface-alpha * 100) + "%";
                                    color: Theme.muted;
                                    font-size: 11px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }

                            Divider { }

                            ActionRow {
                                icon: Icons.edit;
                                label: "Edit custom theme\u{2026}";
                                clicked => { root.run-command("edit-theme"); }
                            }
                        }

                        if root.page == "writing": VerticalLayout {
                            spacing: 10px;

                            SectionLabel { text: "TEXT"; }
                            TextControls {
                                zoom(step) => { root.zoom(step); }
                                set-line-spacing(value) => { root.set-line-spacing(value); }
                            }

                            Divider { }

                            VerticalLayout {
                                SettingRow {
                                    label: "Wide layout";
                                    checked <=> root.wide;
                                    toggled(on) => { root.set-wide(on); }
                                }
                                SettingRow {
                                    label: "Zen mode";
                                    detail: "Ctrl+Shift+Z · Esc to leave";
                                    // Zen lives in the UI only; the two-way binding is all it needs.
                                    checked <=> root.zen;
                                }
                                SettingRow {
                                    label: "Typewriter scrolling";
                                    detail: "In zen mode, keep the line you're on centred";
                                    checked <=> root.typewriter;
                                    toggled(on) => { root.set-typewriter(on); }
                                }
                                SettingRow {
                                    label: "Spotlight";
                                    detail: "In zen mode, fade the text above and below you";
                                    checked <=> root.spotlight;
                                    toggled(on) => { root.set-spotlight(on); }
                                }
                            }
                        }

                        if root.page == "general": VerticalLayout {
                            SettingRow {
                                label: "Keep running in the tray";
                                detail: "Closing the window hides it so reminders still fire. Off: closing quits Zima";
                                checked <=> root.close-to-tray;
                                toggled(on) => { root.set-close-to-tray(on); }
                            }
                            SettingRow {
                                label: "Launch at login";
                                detail: "Starts in the tray so reminders fire";
                                checked <=> root.launch-at-login;
                                toggled(on) => { root.set-launch-at-login(on); }
                            }
                            SettingRow {
                                label: "Low-memory rendering";
                                detail: "Draw with the CPU, not the GPU: ~90 MB less memory. Restart needed";
                                checked <=> root.software-rendering;
                                toggled(on) => { root.set-software-rendering(on); }
                            }
                        }

                        if root.page == "sync": VerticalLayout {
                            spacing: 10px;

                            SectionLabel { text: "SYNC"; }
                            VerticalLayout {
                                spacing: 6px;
                                Text {
                                    text: (root.sync-active ? "Synced folder: " : "Notes are stored on this PC: ") + root.sync-location;
                                    color: Theme.ink-soft;
                                    font-size: 11.5px;
                                    wrap: word-wrap;
                                }
                                if !root.sync-active: Hint {
                                    text: root.google-drive-path != ""
                                        ? "Google Drive found at " + root.google-drive-path + ". Your notes will go in a \u{201c}Zima\u{201d} folder there and sync to your other devices."
                                        : "Install Google Drive for desktop to sync with Google Drive, or pick any synced folder (OneDrive, Dropbox).";
                                }
                            }
                            VerticalLayout {
                                if !root.sync-active && root.google-drive-path != "": ActionRow {
                                    icon: Icons.folder;
                                    label: "Use Google Drive";
                                    clicked => { root.use-google-drive(); }
                                }
                                ActionRow {
                                    icon: Icons.folder;
                                    label: root.sync-active ? "Move to another folder\u{2026}" : "Choose a synced folder\u{2026}";
                                    clicked => { root.choose-sync-folder(); }
                                }
                                if root.sync-active: ActionRow {
                                    icon: Icons.restore;
                                    label: "Stop syncing (keep notes on this PC)";
                                    clicked => { root.stop-syncing(); }
                                }
                            }

                            Divider { }

                            SectionLabel { text: "BACKUPS"; }
                            Hint {
                                text: "Once a day Zima zips all your notes into the backups folder on this PC and keeps the most recent ones.";
                            }
                            VerticalLayout {
                                ActionRow {
                                    icon: Icons.export;
                                    label: "Back up now";
                                    clicked => { root.run-command("backup"); }
                                }
                                ActionRow {
                                    icon: Icons.folder;
                                    label: "Open backups folder";
                                    clicked => { root.open-backups-folder(); }
                                }
                                ActionRow {
                                    icon: Icons.folder;
                                    label: "Open notes folder";
                                    clicked => { root.open-notes-folder(); }
                                }
                            }

                            Divider { }

                            SectionLabel { text: "VERSION HISTORY"; }
                            SettingRow {
                                label: "Keep version history";
                                detail: "An older copy of each note about every 10 minutes while you edit, kept on this PC. Right-click a note for its history";
                                checked <=> root.version-history;
                                toggled(on) => { root.set-version-history(on); }
                            }
                            ActionRow {
                                icon: Icons.trash;
                                label: root.clear-armed ? "Click again to delete every saved copy" : "Clear history";
                                clicked => {
                                    if (root.clear-armed) {
                                        root.clear-armed = false;
                                        root.run-command("clear-history");
                                    } else {
                                        root.clear-armed = true;
                                    }
                                }
                            }
                        }

                        if root.page == "files": VerticalLayout {
                            ActionRow {
                                icon: Icons.export;
                                label: "Export all notes as a zip\u{2026}";
                                clicked => { root.export-all(); }
                            }
                            ActionRow {
                                icon: Icons.export;
                                label: "Export note as Markdown\u{2026}";
                                enabled: root.has-note;
                                clicked => { root.export-note(); }
                            }
                            ActionRow {
                                icon: Icons.import;
                                label: "Import a folder of Markdown notes\u{2026}";
                                clicked => { root.import-markdown-folder(); }
                            }
                            ActionRow {
                                icon: Icons.import;
                                label: "Import from Zima\u{2026}";
                                clicked => { root.import-zima(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
