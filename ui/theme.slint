import { Palette } from "std-widgets.slint";

export struct ThemeInfo {
    name: string,
    // A plain colour for the Settings swatch, or, for themes with a gradient, `picture`. The CPU
    // renderer (Low-memory rendering) draws gradients with square corners and stray lines, but
    // draws pictures right.
    swatch: color,
    picture: image,
    accent: color,
}

export global Theme {
    // 0 = follow system, 1 = Light, 2 = Dark, 3 = Ethereal, 4 = Zima Blue, 5 = Blue White (7 = Custom sets `custom`).
    in-out property <int> choice: 0;
    // What the user picked, for highlighting in Settings (6 = Auto, which sets `choice` by time of day; 7 = Custom).
    in-out property <int> selected-theme: 0;
    // A custom accent colour overrides the theme's.
    in-out property <bool> has-custom-accent;
    in-out property <color> custom-accent;
    // Opacity of the window surfaces (0.3–1.0); below 1 the Mica backdrop shows through.
    in-out property <float> surface-alpha: 1.0;
    // Font for note text; the UI chrome stays Segoe UI.
    in-out property <string> font: "Inter";
    // Ctrl + / Ctrl − text size, and line spacing, for note text.
    in-out property <float> text-scale: 1.0;
    // Size of the whole interface (shown in Settings; the window itself is scaled from Rust).
    in-out property <float> ui-scale: 1.0;
    in-out property <float> line-spacing: 1.25;

    // Custom theme (theme.json in the notes folder), set from Rust. `choice` is then 1 or 2 to match.
    in-out property <bool> custom;
    in-out property <bool> custom-dark: true;
    in-out property <string> custom-name: "Custom";
    in-out property <color> custom-paper: #1c1b1a;
    in-out property <color> custom-sidebar: #171615;
    in-out property <color> custom-ink: #e8e4dd;
    in-out property <color> custom-ink-soft: #b5afa6;
    in-out property <color> custom-muted: #7d786f;
    in-out property <color> custom-rule: #2a2826;
    in-out property <color> custom-hover: #ffffff0c;
    in-out property <color> custom-selected: #ffffff16;
    in-out property <color> custom-theme-accent: #c8794a;
    in-out property <color> custom-on-accent: #ffffff;
    in-out property <color> custom-popover: #252321;
    // Window background, top and bottom of a gradient.
    in-out property <color> custom-backdrop-top: #1c1b1a;
    in-out property <color> custom-backdrop-bottom: #1c1b1a;
    property <brush> custom-backdrop: @linear-gradient(180deg, root.custom-backdrop-top 0%, root.custom-backdrop-bottom 100%);

    out property <int> index: root.choice == 0 ? (Palette.color-scheme == ColorScheme.dark ? 2 : 1) : root.choice;
    property <int> i: root.index - 1;
    out property <bool> dark: root.custom ? root.custom-dark : root.index != 1 && root.index != 8;

    // One entry per theme, in `index` order: Light … Blue White, (Auto and Custom: unused), Sakura, Cyberpunk, Expedition 33.
    property <[color]> papers: [#faf8f5, #1c1b1a, #0d0c1d, #1a1a1f, #12b5e5, #1c1b1a, #1c1b1a, #fdf6f7, #0d0b14, #13151d];
    property <[color]> sidebars: [#f2efe9, #171615, #12112a, #1d2e35, #0ea5e9, #171615, #171615, #f8e9ee, #110e1c, #0f1118];
    property <[color]> inks: [#2b2926, #e8e4dd, #f0f4ff, #ffffff, #ffffff, #e8e4dd, #e8e4dd, #4a2d36, #f2f0ff, #ece3cf];
    property <[color]> ink-softs: [#5e5952, #b5afa6, #c7cffb, #c9e4ec, #f0f9ff, #b5afa6, #b5afa6, #7a5561, #c3b8f0, #c2b598];
    property <[color]> muteds: [#a39d93, #7d786f, #8189c4, #6f9fae, #c7ecfa, #7d786f, #7d786f, #b48a96, #7a6fa8, #857a66];
    property <[color]> rules: [#e7e2d9, #2a2826, #ffffff1c, #12b5e533, #ffffff4d, #2a2826, #2a2826, #f0d9df, #ff2a6d33, #c9a45c26];
    property <[color]> hovers: [#00000009, #ffffff0c, #ffffff10, #12b5e514, #ffffff1f, #ffffff0c, #ffffff0c, #c7577a0d, #05d9e814, #e9dfc80d];
    property <[color]> selecteds: [#00000010, #ffffff16, #ffffff1e, #12b5e52e, #ffffff38, #ffffff16, #ffffff16, #c7577a1a, #ff2a6d2a, #c9a45c22];
    property <[color]> accents: [#c8794a, #c8794a, #d8b4fe, #12b5e5, #ffffff, #c8794a, #c8794a, #e0709a, #fcee0a, #d4af6a];
    property <[color]> on-accents: [#ffffff, #ffffff, #1a1033, #ffffff, #0e8fc4, #ffffff, #ffffff, #ffffff, #0d0b14, #1a1408];
    property <[color]> popovers: [#ffffff, #252321, #1a1838, #22343c, #0e9fd9, #252321, #252321, #fffafb, #171327, #1b1d27];

    out property <color> paper: root.custom ? root.custom-paper : root.papers[root.i];
    out property <color> sidebar: root.custom ? root.custom-sidebar : root.sidebars[root.i];
    out property <color> ink: root.custom ? root.custom-ink : root.inks[root.i];
    out property <color> ink-soft: root.custom ? root.custom-ink-soft : root.ink-softs[root.i];
    out property <color> muted: root.custom ? root.custom-muted : root.muteds[root.i];
    out property <color> rule: root.custom ? root.custom-rule : root.rules[root.i];
    out property <color> hover: root.custom ? root.custom-hover : root.hovers[root.i];
    out property <color> selected: root.custom ? root.custom-selected : root.selecteds[root.i];
    out property <color> accent: root.has-custom-accent ? root.custom-accent : root.custom ? root.custom-theme-accent : root.accents[root.i];
    out property <color> on-accent: root.has-custom-accent ? #ffffff : root.custom ? root.custom-on-accent : root.on-accents[root.i];
    out property <color> popover: root.custom ? root.custom-popover : root.popovers[root.i];
    out property <color> selection: root.accent.with-alpha(root.dark ? 0.35 : 0.22);
    out property <color> danger: #e5484d;

    // Window background: Zima's gradients for its themes, plain paper otherwise.
    out property <brush> backdrop: root.custom ? root.custom-backdrop
        : root.index == 3 ? @radial-gradient(circle, #2b2057 0%, #0d0c1d 75%)
        : root.index == 4 ? @linear-gradient(180deg, #1a1a1f 0%, #1d2e35 100%)
        : root.index == 5 ? @linear-gradient(180deg, #12b5e5 0%, #0ea5e9 100%)
        // Sakura: blossom pink fading into paper.
        : root.index == 8 ? @linear-gradient(180deg, #fbe4ec 0%, #fdf6f7 45%, #fdf6f7 100%)
        // Cyberpunk: violet dusk into teal neon.
        : root.index == 9 ? @linear-gradient(160deg, #1d0b33 0%, #0d0b14 55%, #00202b 100%)
        // Expedition 33: night blue with a crimson, painterly glow below.
        : root.index == 10 ? @linear-gradient(180deg, #181b28 0%, #13151d 55%, #2a141b 100%)
        : root.paper;

    out property <[ThemeInfo]> themes: [
        { name: "System", picture: @image-url("swatches/system.svg"), accent: #c8794a },
        { name: "Light", swatch: #faf8f5, accent: #c8794a },
        { name: "Dark", swatch: #1c1b1a, accent: #c8794a },
        { name: "Ethereal", picture: @image-url("swatches/ethereal.svg"), accent: #d8b4fe },
        { name: "Zima Blue", picture: @image-url("swatches/zima-blue.svg"), accent: #12b5e5 },
        { name: "Blue White", picture: @image-url("swatches/blue-white.svg"), accent: #ffffff },
        { name: "Auto", picture: @image-url("swatches/auto.svg"), accent: #c8794a },
        // Its colours come from theme.json, so no picture: halfway between the top and bottom.
        { name: root.custom-name, swatch: root.custom-backdrop-top.mix(root.custom-backdrop-bottom, 0.5), accent: root.custom-theme-accent },
        { name: "Sakura", picture: @image-url("swatches/sakura.svg"), accent: #e0709a },
        { name: "Cyberpunk", picture: @image-url("swatches/cyberpunk.svg"), accent: #fcee0a },
        { name: "Expedition 33", picture: @image-url("swatches/expedition-33.svg"), accent: #d4af6a },
    ];

    // Accent colours offered in Settings (hex strings are what gets saved).
    out property <[color]> accent-choices: [#c8794a, #e5484d, #f76b15, #d6a000, #46a758, #12a594, #0090ff, #6e56cf, #d6409f];
    out property <[string]> accent-hexes: ["#c8794a", "#e5484d", "#f76b15", "#d6a000", "#46a758", "#12a594", "#0090ff", "#6e56cf", "#d6409f"];

    // Note colours (sidebar dots): red, orange, yellow, green, teal, blue, purple.
    out property <[color]> note-colors: [#e5484d, #f76b15, #f5b70a, #46a758, #12a594, #0090ff, #8e4ec6];

    // Bundled fonts (see fonts/).
    out property <[string]> fonts: ["Inter", "Newsreader", "Literata", "JetBrains Mono"];
    out property <[string]> font-labels: ["Sans", "Serif", "Book", "Mono"];
}
