export component Icon inherits Path {
    viewbox-width: 12;
    viewbox-height: 12;
    width: 14px;
    height: 14px;
    fill: transparent;
    stroke-width: 1.3px;
    stroke-line-cap: round;
    stroke-line-join: round;
}

export component IconButton {
    in property <string> icon;
    in property <bool> filled;
    in property <color> color: Theme.muted;
    in property <color> hover-color: Theme.ink;
    in property <length> size: 26px;
    in property <length> icon-size: 14px;
    // Shown pressed, e.g. while its popover or toolbar is open.
    in property <bool> active;
    // What screen readers announce.
    in property <string> description;
    out property <bool> has-hover: touch.has-hover;
    callback clicked();

    accessible-role: button;
    accessible-label: root.description;
    accessible-action-default => { root.clicked(); }

    width: root.size;
    height: root.size;

    property <color> tint: touch.has-hover || root.active ? root.hover-color : root.color;

    Rectangle {
        border-radius: 6px;
        background: touch.pressed || root.active ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
        animate background { duration: 120ms; }
    }

    Icon {
        width: root.icon-size;
        height: root.icon-size;
        commands: root.icon;
        stroke: root.tint;
        fill: root.filled ? root.tint : transparent;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// One macOS-style "traffic light" window button.
export component TrafficLight {
    in property <color> base;
    in property <color> glyph-color;
    // SVG path data, drawn in a 12x12 viewbox.
    in property <string> icon;
    in property <bool> filled;
    in property <bool> show-glyph;
    // What screen readers announce.
    in property <string> description;
    callback clicked();

    accessible-role: button;
    accessible-label: root.description;
    accessible-action-default => { root.clicked(); }

    width: 12px;
    height: 12px;

    Rectangle {
        border-radius: self.width / 2;
        background: touch.pressed ? root.base.darker(0.25) : root.base;
        border-width: 0.5px;
        border-color: root.base.darker(0.3);
    }

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: root.icon;
        visible: root.show-glyph;
        fill: root.filled ? root.glyph-color : transparent;
        stroke: root.filled ? transparent : root.glyph-color;
        stroke-width: 1.3px;
        stroke-line-cap: round;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Invisible strip along a window edge that starts a native resize.
export component ResizeEdge inherits TouchArea {
    in property <string> direction;
    callback resize(string);

    pointer-event(ev) => {
        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
            root.resize(root.direction);
        }
    }
}

// Starts a native window drag on left-press (double-click maximizes; handled in Rust).
export component DragArea inherits TouchArea {
    callback drag();

    pointer-event(ev) => {
        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
            root.drag();
        }
    }
}

// A pill-shaped on/off switch.
export component Toggle {
    in-out property <bool> checked;
    in property <string> description;
    callback toggled(bool);

    accessible-role: switch;
    accessible-label: root.description;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => {
        root.checked = !root.checked;
        root.toggled(root.checked);
    }

    width: 32px;
    height: 18px;

    Rectangle {
        border-radius: self.height / 2;
        background: root.checked ? Theme.accent : Theme.selected;
        animate background { duration: 150ms; }

        Rectangle {
            x: root.checked ? parent.width - self.width - 2px : 2px;
            animate x { duration: 150ms; easing: ease-out; }
            width: 14px;
            height: 14px;
            border-radius: 7px;
            background: root.checked ? Theme.on-accent : Theme.paper;
            drop-shadow-blur: 2px;
            drop-shadow-color: #00000030;
        }
    }

    TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// A minimal slider; `changed` fires while dragging.
export component Slider {
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in-out property <float> value;
    in property <string> description;
    callback changed(float);

    accessible-role: slider;
    accessible-label: root.description;
    accessible-value: Math.round(root.fraction * 100) + "%";
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;

    height: 20px;

    property <float> fraction: (root.value - root.minimum) / (root.maximum - root.minimum);

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.selected;
    }

    // Filled part, from the left edge to the knob's centre. Needs an explicit x: Slint centres
    // elements without one, which pulled the fill away from the knob as the value changed.
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: root.fraction * (root.width - 14px) + 7px;
        height: 4px;
        border-radius: 2px;
        background: Theme.accent;
    }

    Rectangle {
        x: root.fraction * (root.width - self.width);
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: Theme.paper;
        border-width: 2px;
        border-color: Theme.accent;
    }

    touch := TouchArea {
        function set-from(x: length) {
            root.value = root.minimum + max(0, min(1, (x - 7px) / (root.width - 14px))) * (root.maximum - root.minimum);
            root.changed(root.value);
        }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                self.set-from(self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) {
                self.set-from(self.mouse-x);
            }
        }
    }
}

// A formatting toolbar button showing either an icon or a short label.
export component FormatButton {
    in property <string> icon;
    in property <string> label;
    in property <int> label-weight: 600;
    in property <bool> label-italic;
    // A small rainbow bar under the label, for the text colour button.
    in property <bool> swatch;
    in property <string> tooltip;
    callback clicked();

    accessible-role: button;
    accessible-label: root.tooltip != "" ? root.tooltip : root.label;
    accessible-action-default => { root.clicked(); }

    width: 30px;
    height: 28px;

    Rectangle {
        border-radius: 6px;
        background: touch.pressed ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
        animate background { duration: 120ms; }
    }

    if root.icon != "": Icon {
        width: 14px;
        height: 14px;
        commands: root.icon;
        stroke: touch.has-hover ? Theme.ink : Theme.ink-soft;
    }

    if root.label != "": Text {
        text: root.label;
        color: touch.has-hover ? Theme.ink : Theme.ink-soft;
        font-size: 14px;
        font-weight: root.label-weight;
        font-italic: root.label-italic;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.swatch: Rectangle {
        y: parent.height - 6px;
        width: 14px;
        height: 3px;
        border-radius: 1.5px;
        background: @linear-gradient(90deg, #dc2626 0%, #ea580c 25%, #16a34a 50%, #2563eb 75%, #9333ea 100%);
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A text colour offered on the formatting toolbar; `name` is "" for the plain highlight.
export struct ColourDot {
    name: string,
    title: string,
    light: color,
    dark: color,
}

// The row of colour dots under the toolbar's colour button.
export component ColourPicker {
    in property <[ColourDot]> colours;
    callback pick(string);

    width: layout.preferred-width;
    height: layout.preferred-height;

    // Swallow clicks between the dots so they don't close the picker.
    TouchArea { }

    Rectangle {
        border-radius: 10px;
        background: Theme.popover;
        border-width: 1px;
        border-color: Theme.rule;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 6px;
        drop-shadow-color: #00000040;
    }

    layout := HorizontalLayout {
        padding: 6px;
        spacing: 2px;

        for dot in root.colours: Rectangle {
            width: 26px;
            height: 26px;
            border-radius: 6px;
            background: dot-touch.pressed ? Theme.selected : dot-touch.has-hover ? Theme.hover : transparent;
            accessible-role: button;
            accessible-label: dot.title;
            accessible-action-default => { root.pick(dot.name); }

            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: Theme.dark ? dot.dark : dot.light;
            }

            dot-touch := TouchArea {
                clicked => { root.pick(dot.name); }
            }
        }
    }
}
